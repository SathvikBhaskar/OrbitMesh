NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://orbitmesh:orbitmesh_dev_password@localhost:5432/orbitmesh

# Data Provider Configuration
# Mode: "demo" (deterministic) or "real" (live fetch)
DATA_PROVIDER=demo

# CelesTrak Real Data Configuration (used if DATA_PROVIDER=real)
CELESTRAK_GROUP=weather
CELESTRAK_FORMAT=json
CELESTRAK_MAX_SATELLITES=50
